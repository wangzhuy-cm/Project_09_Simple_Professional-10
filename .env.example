# API key = secret used only when you click an OpenAI action.
# ChatGPT Plus does not automatically provide an API key; API usage may have separate cost.
# Copy this file to project root/.env. Never commit/share .env or a real key.
# Google AI Studio keys beginning with AIza are not OpenAI keys and cannot be used here.
OPENAI_API_KEY=
# Model dùng cho Responses API + Structured Outputs. Nếu tài khoản không có
# quyền dùng model này, web sẽ báo api_model_not_found/api_permission_denied.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
